# FORM Store — configuration reference
#
# Copy to .env and fill in. Nothing here is read by the frontend: the browser
# never sees a key. Every credential is held by n8n, which is the only
# component that talks to the databases and the paid APIs.
#
# Values marked [n8n UI] are not environment variables — they are stored in
# n8n's own credential vault and are listed here so the reader knows what has
# to be configured before the workflows will run.


# --- Environment variables (set in the shell before starting n8n) -----------

# n8n blocks Node built-in modules inside Code nodes by default. The Stripe
# webhook verifies the HMAC signature itself, so `crypto` has to be allowed.
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# Telegram bot token for the admin notifications and inline status buttons.
TG_BOT_TOKEN=

# Public URL n8n advertises to external services. Only needed when Stripe or
# Telegram must reach the local instance — typically a cloudflared tunnel.
# Leave unset for catalogue, cart and try-on work, which are all same-network.
WEBHOOK_URL=


# --- Credentials configured inside n8n --------------------------------------

# [n8n UI] Supabase — stored as a Custom Auth credential, not Header Auth,
# because PostgREST needs two headers at once:
#   { "apikey": "<service_role JWT>",
#     "Authorization": "Bearer <service_role JWT>" }
# The service_role key bypasses row level security, which is why it lives
# server-side only and is never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# [n8n UI] OpenAI — embeddings for the product index, chat completion for the
# shopping assistant and the intent router.
OPENAI_API_KEY=

# [n8n UI] Stripe — test mode. The secret key creates Checkout Sessions; the
# webhook secret verifies that incoming events really came from Stripe.
# Both must belong to the same Stripe environment: a key from the sandbox with
# a webhook from the test account fails silently, with no delivery at all.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# [n8n UI] FASHN — virtual try-on. Billed per generation, so the daily quota
# in increment_vton_usage is a cost control, not a rate limit.
FASHN_API_KEY=


# --- Local services ---------------------------------------------------------

# Qdrant, run in Docker. Collection `clothing_store`, 1536 dimensions, cosine.
QDRANT_URL=http://localhost:6333

{"updatedAt":"2026-08-07T14:25:05.902Z","createdAt":"2026-08-06T14:16:20.592Z","id":"Od2erzbY9TGUj07V","name":"M4 — Stripe webhook","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"9010453e-d670-495f-893e-1ec941d9f350","responseMode":"responseNode","options":{"rawBody":true}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"id":"520a565d-fc1d-41d7-9b5a-98f2dbae2e37","name":"Webhook","webhookId":"9010453e-d670-495f-893e-1ec941d9f350"},{"parameters":{"respondWith":"text","responseBody":"ok","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[1104,288],"id":"e840404b-133b-4e5b-9d11-9e9c341bd5ab","name":"Respond to Webhook"},{"parameters":{"jsCode":"const crypto = require('crypto');\n\nconst SECRET = 'whsec_YOUR_STRIPE_WEBHOOK_SECRET';\n\nconst item    = $input.first();\nconst headers = $('Webhook').first().json.headers;\nconst raw     = Buffer.from(item.binary.data.data, 'base64').toString('utf8');\n\nconst sigHeader = headers['stripe-signature'];\nif (!sigHeader) throw new Error('NO_SIGNATURE');\n\n// t=...,v1=...  → розбираємо на частини\nconst parts = Object.fromEntries(\n  sigHeader.split(',').map(p => p.split('='))\n);\n\nconst expected = crypto\n  .createHmac('sha256', SECRET)\n  .update(`${parts.t}.${raw}`)\n  .digest('hex');\n\nif (expected !== parts.v1) throw new Error('BAD_SIGNATURE');\n\n// захист від повтору старого запиту\nconst ageSec = Math.floor(Date.now() / 1000) - Number(parts.t);\nif (ageSec > 300) throw new Error('SIGNATURE_TOO_OLD');\n\nconst event = JSON.parse(raw);\n\nreturn [{ json: {\n  event_id: event.id,\n  type:     event.type,\n  session_id: event.data.object.id,\n  order_id:   Number(event.data.object.metadata?.order_id ?? event.data.object.client_reference_id)\n} }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[208,128],"id":"39db2970-e46e-4344-98fd-dbaa4260e700","name":"Verify signature"},{"parameters":{"method":"POST"
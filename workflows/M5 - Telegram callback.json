{"updatedAt":"2026-08-07T15:32:57.741Z","createdAt":"2026-08-07T14:30:08.694Z","id":"Rf2FkMiSdpcvkLvi","name":"M5 — Telegram callback","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"70ac2545-38dd-46ac-93ed-17000eef1939","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-48,0],"id":"8c0ccee6-37ff-4335-8968-512c5a074186","name":"Webhook","webhookId":"70ac2545-38dd-46ac-93ed-17000eef1939"},{"parameters":{"jsCode":"const OWNER_CHAT_ID = 332596957;\n\nconst cq = $json.body.callback_query;\n\nif (cq.from.id !== OWNER_CHAT_ID) {\n  return [];\n}\n\nconst [action, orderId] = String(cq.data).split(':');\n\nconst allowed = { accept: 'accepted', ship: 'shipped' };\nconst nextStatus = allowed[action] || null;\n\nreturn [{\n  json: {\n    callback_id: cq.id,\n    chat_id: cq.message.chat.id,\n    message_id: cq.message.message_id,\n    message_text: cq.message.text,\n    order_id: Number(orderId),\n    next_status: nextStatus\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[368,-160],"id":"ea5f0489-359a-4605-88ee-ed12a794ec99","name":"Parse callback"},{"parameters":{"method":"POST","url":"https://tzbdpjqkhycsvnxodzlo.supabase.co/rest/v1/rpc/advance_order_status","authentication":"genericCredentialType","genericAuthType":"httpCustomAuth","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"p_order_id\": {{ $json.order_id }},\n  \"p_to\": \"{{ $json.next_status }}\"\n}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[576,-32],"id":"6c03639a-d319-4ec1-84ad-87699d83eedf","name":"Advance status","credentials":{"httpCustomAuth":{"id":"pw9mfUmzKoSip0I0","name":"Supabase service_role (custom)"}}},{"parameters":{"method":"POST","url":"=https://api.telegram.org/bot{{ $env.TG_BOT_TOKEN }}/answerCallbackQuery","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"callback_query_id\": \"{{ $json.callback_id }}\"\n}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[576,-224],"id":"0aba563e-cbec-40ec-8a3f-eb2d343f2328","name":"Answer callback"},{"parameters":{"jsCode":"const p = $('Parse callback').first().json;\nconst res = $('Advance status').first().json;\n\nconst status = res.status;\n\nconst baseText = String(p.message_text).split('\\n\\nStatus:')[0];\n\nconst labels = {\n  paid: 'paid',\n  accepted: 'accepted',\n  shipped: 'shipped'\n};\n\nconst text = `${baseText}\\n\\nStatus: <b>${labels[status] || status}</b>`;\n\nconst nextButton = {\n  paid: { text: 'Accept', callback_data: `accept:${p.order_id}` },\n  accepted: { text: 'Mark shipped', callback_data: `ship:${p.order_id}` }\n};\n\nconst btn = nextButton[status];\nconst keyboard = btn ? { inline_keyboard: [[btn]] } : { inline_keyboard: [] };\n\nreturn [{\n  json: {\n    chat_id: p.chat_id,\n    message_id: p.message_id,\n    text,\n    keyboard\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[800,-112],"id":"7d5c2fa7-8c9a-4c70-883e-ae7ced32417c","name":"Build update"},{"parameters":{"method":"POST","url":"=https://api.telegram.org/bot{{ $env.TG_BOT_TOKEN }}/editMessageText","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"chat_id\": {{ $json.chat_id }},\n  \"message_id\": {{ $json.message_id }},\n  \"text\": {{ JSON.stringify($json.text) }},\n  \"parse_mode\": \"HTML\",\n  \"reply_markup\": {{ JSON.stringify($json.keyboard) }}\n}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[992,-112],"id":"b9020f21-007f-478a-ad9a-30d7347b57db","name":"Update message"},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"leftValue":"={{ $json.body.callback_query ? 'callback' : 'message' }}","rightValue":"callback","operator":{"type":"string","operation":"equals"},"id":"cb81c5ff-aaf7-454e-bfc0-248d8a5b99ac"}],"combinator":"and"},"renameOutput":true,"outputKey":"callback"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"2481f24b-1ab2-4acd-a37d-20f8db37cf39","leftValue":"={{ $json.body.callback_query ? 'callback' : 'message' }}","rightValue":"message","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"message"}]},"options":{}},"type":"n8n-nodes-base.switch","typeVersion":3.4,"position":[128,80],"id":"2bd7dfdd-906f-4e17-afe4-60114c43fe5a","name":"Route update"},{"parameters":{"jsCode":"const OWNER_CHAT_ID = 332596957;\n\nconst msg = $json.body.message;\nconst text = String(msg.text || '').trim().toLowerCase();\n\nif (msg.chat.id !== OWNER_CHAT_ID) {\n  return [];\n}\n\nreturn [{\n  json: {\n    chat_id: msg.chat.id,\n    command: text.split(' ')[0],\n    is_orders: text.split(' ')[0] === '/orders'\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[336,176],"id":"2ec7f3ad-bbb0-4c2c-85af-ea35eb1c2ef3","name":"Parse command"},{"parameters":{"url":"https://tzbdpjqkhycsvnxodzlo.supabase.co/rest/v1/orders","authentication":"genericCredentialType","genericAuthType":"httpCustomAuth","sendQuery":true,"queryParameters":{"parameters":[{"name":"select","value":"id,customer_name,total_amount,status,paid_at"},{"name":"status","value":"in.(paid,accepted)"},{"name":"order","value":"id.desc"},{"name":"limit","value":"20"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[544,176],"id":"77504ba4-f573-481f-a291-c5e353ab53e3","name":"Get active orders","credentials":{"httpCustomAuth":{"id":"pw9mfUmzKoSip0I0","name":"Supabase service_role (custom)"}}},{"parameters":{"jsCode":"const cmd = $('Parse command').first().json;\n\nif (!cmd.is_orders) {\n  return [{\n    json: {\n      chat_id: cmd.chat_id,\n      text: 'Unknown command. Use /orders to see active orders.'\n    }\n  }];\n}\n\nconst orders = $input.all().map(i => i.json).filter(o => o && o.id);\n\nif (orders.length === 0) {\n  return [{\n    json: {\n      chat_id: cmd.chat_id,\n      text: '<b>Active orders</b>\\n\\nNothing in progress.'\n    }\n  }];\n}\n\nconst lines = orders.map(o => {\n  const when = o.paid_at ? new Date(o.paid_at).toISOString().slice(0, 16).replace('T', ' ') : '—';\n  return `#${o.id} — ${o.status} — €${Number(o.total_amount).toFixed(2)} — ${o.customer_name} — ${when}`;\n}).join('\\n');\n\nreturn [{\n  json: {\n    chat_id: cmd.chat_id,\n    text: `<b>Active orders (${orders.length})</b>\\n\\n${lines}`\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[752,176],"id":"132f337c-0d0a-478c-8dc2-d7fcfbb6c000","name":"Build orders list"},{"parameters":{"method":"POST","url":"=https://api.telegram.org/bot{{ $env.TG_BOT_TOKEN }}/sendMessage","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"chat_id\": {{ $json.chat_id }},\n  \"text\": {{ JSON.stringify($json.text) }},\n  \"parse_mode\": \"HTML\"\n}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[960,176],"id":"138ca97d-538e-4c6d-a6cc-d4c537d9db38","name":"Send orders list"}],"connections":{"Webhook":{"main":[[{"node":"Route update","type":"main","index":0}]]},"Parse callback":{"main":[[{"node":"Answer callback","type":"main","index":0},{"node":"Advance status","type":"main","index":0}]]},"Advance status":{"main":[[{"node":"Build update","type":"main","index":0}]]},"Answer callback":{"main":[[]]},"Build update":{"main":[[{"node":"Update message","type":"main","index":0}]]},"Route update":{"main":[[{"node":"Parse callback","type":"main","index":0}],[{"node":"Parse command","type":"main","index":0}]]},"Parse command":{"main":[[{"node":"Get active orders","type":"main","index":0}]]},"Get active orders":{"main":[[{"node":"Build orders list","type":"main","index":0}]]},"Build orders list":{"main":[[{"node":"Send orders list","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","binaryMode":"separate","availableInMCP":false},"staticData":null,"
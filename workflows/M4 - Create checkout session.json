{"updatedAt":"2026-08-06T13:46:05.598Z","createdAt":"2026-08-06T12:16:25.766Z","id":"Eg57lz6vO4B2PZzK","name":"M4 — Create checkout session","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"dd3386d8-9d3d-4255-9d5d-9e6219e38b38","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"id":"855170bd-07ca-4d21-8ea1-b8797234c217","name":"Webhook","webhookId":"dd3386d8-9d3d-4255-9d5d-9e6219e38b38"},{"parameters":{"url":"https://tzbdpjqkhycsvnxodzlo.supabase.co/rest/v1/order_line_items","authentication":"genericCredentialType","genericAuthType":"httpCustomAuth","sendQuery":true,"queryParameters":{"parameters":[{"name":"order_id","value":"={{ \"eq.\" + $json.body.order_id }}"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[208,0],"id":"a1b67252-5dc8-4237-8457-2cdd9b6c7337","name":"Get line items","credentials":{"httpCustomAuth":{"id":"pw9mfUmzKoSip0I0","name":"Supabase service_role (custom)"}}},{"parameters":{"options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[1248,0],"id":"f897ab7c-836a-46a8-974b-40a72ca98158","name":"Respond to Webhook"},{"parameters":{"jsCode":"const rows = $input.all().map(i => i.json);\n\nif (rows.length === 0) {\n  throw new Error('ORDER_EMPTY');\n}\n\nconst orderId = rows[0].order_id;\n\n// Stripe: суми в центах, цілим числом\nconst params = {\n  mode: 'payment',\n  'payment_method_types[0]': 'card',\n  success_url: `http://localhost:8080/?paid=1&order=${orderId}`,\n  cancel_url:  `http://localhost:8080/?cancelled=1&order=${orderId}`,\n  expires_at:  Math.floor(Date.now() / 1000) + 30 * 60,\n  'metadata[order_id]': String(orderId),\n  client_reference_id: String(orderId)\n};\n\nrows.forEach((r, n) => {\n  const cents = Math.round(Number(r.price_at_purchase) * 100);\n  const label = `${r.product_name} — ${r.size} / ${r.color}`;\n\n  params[`line_items[${n}][price_data][currency]`] = 'eur';\n  params[`line_items[${n}][price_data][product_data][name]`] = label;\n  params[`line_items[${n}][price_data][unit_amount]`] = cents;\n  params[`line_items[${n}][quantity]`] = r.quantity;\n});\n\nconst body = Object.entries(params)\n  .map(([k, v]) => encodeURIComponent(k) + '=' + encodeURIComponent(v))\n  .join('&');\n\nreturn [{ json: { order_id: orderId, body } }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[416,0],"id":"200418fd-6d33-4699-bd1c-c9ea78165d6e","name":"Build Stripe payload"},{"parameters":{"method":"POST","url":"https://api.stripe.com/v1/checkout/sessions","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"contentType":"form-urlencoded","specifyBody":"string","body":"={{ $json.body }}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[624,0],"id":"f9f5693f-1b6b-4e6e-96df-b33435afabdc","name":"Create Stripe session","credentials":{"httpHeaderAuth":{"id":"D7VdlxfdplznWZrI","name":"Stripe Test Secret"}}},{"parameters":{"method":"PATCH","url":"https://tzbdpjqkhycsvnxodzlo.supabase.co/rest/v1/orders","authentication":"genericCredentialType","genericAuthType":"httpCustomAuth","sendQuery":true,"queryParameters":{"parameters":[{"name":"id","value":"={{ \"eq.\" + $('Build Stripe payload').item.json.order_id }}"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ stripe_session_id: $json.id }) }}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[832,0],"id":"ac6e6135-1ae4-4c71-9f09-adbb563e2ac0","name":"Save session id","credentials":{"httpCustomAuth":{"id":"pw9mfUmzKoSip0I0","name":"Supabase service_role (custom)"}}},{"parameters":{"jsCode":"const session = $('Create Stripe session').first().json;\n\nreturn [{\n  json: {\n    ok: true,\n    order_id: $('Build Stripe payload').first().json.order_id,\n    checkout_url: session.url,\n    session_id: session.id\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1040,0],"id":"e7028690-c980-435e-bfa5-354db16ee0fb","name":"Format response"}],"connections":{"Webhook":{"main":[[{"node":"Get line items","type":"main","index":0}]]},"Get line items":{"main":[[{"node":"Build Stripe payload","type":"main","index":0}]]},"Build Stripe payload":{"main":[[{"node":"Create Stripe session","type":"main","index":0}]]},"Create Stripe session":{"main":[[{"node":"Save session id","type":"main","index":0}]]},"Save session id":{"main":[[{"node":"Format response","type":"main","index":0}]]},"Format response":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","binaryMode":"separate","availableInMCP":false},"staticData":null,"meta":null,"nodeGroups":[],"pinData":{},"versionId":"864f7998-304b-4fdc-b56b-269cc243af26","activeVersionId":"864f7998-304b-4fdc-b56b-269cc243af26","versionCounter":52,"triggerCount":1,"sourceWorkflowId":null,"tags":[{"updatedAt":"2026-07-22T10:46:03.336Z","createdAt":"2026-07-22T10:46:03.336Z","id":"2gFbiRBjrA838zCS","name":"clothing-store"}],"shared":[{"updatedAt":"2026-08-06T12:16:25.770Z","createdAt":"2026-08-06T12:16:25.770Z","role":"workflow:owner","workflowId":"Eg57lz6vO4B2PZzK","projectId":"KpezZEBEcGaEIrbJ","project":{"updatedAt":"2026-06-14T14:59:42.434Z","createdAt":"2026-06-14T14:56:06.560Z","id":"KpezZEBEcGaEIrbJ","name":"Ihor Pidhainyi <pidhainyi.automation@gmail.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"969b01f0-3cb4-486d-8e78-0f2e03479f65"}}],"versionMetadata":{"name":"Version 864f7998","description":""}}